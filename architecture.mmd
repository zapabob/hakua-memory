```mermaid
erDiagram
    %% Core Entities
    MEMORY_SYSTEM {
        string system_id PK
        string type "ebbinghaus|semantic_graph|rag"
        string db_path
        datetime created_at
    }
    
    EBBINGHAUS_MEMORY {
        int memory_id PK
        string content
        string tags
        float salience
        float valence
        float retention
        float stability_days
        string state "active|archived|forgotten"
        string source
        datetime created_at
    }
    
    SEMANTIC_NODE {
        string node_id PK
        string node_type "Claim|Evidence|Fragment"
        string label
        string summary
        string status "asserted|disputed|retracted"
        string authority
        float confidence
        float salience
        json metadata
    }
    
    SEMANTIC_EDGE {
        string edge_id PK
        string source_node_id FK
        string target_node_id FK
        string edge_type "causes|contradicts|supports|requires|enables|prevents|relates_to|part_of|precedes|follows"
        string label
        float confidence
        string status "candidate|accepted|rejected"
        json evidence
    }
    
    RAG_DOCUMENT {
        string document_id PK
        string title
        string author
        string department
        int version
        datetime created_at
    }
    
    RAG_CHUNK {
        string chunk_id PK
        string document_id FK
        int chunk_index
        string content
        string content_hash
        int token_count
    }
    
    CONTRADICTION_RESULT {
        string query_id PK
        string query
        boolean has_contradiction
        string contradiction_type
        float confidence
        json details
        datetime judged_at
    }
    
    SYNTHETIC_DATASET {
        string dataset_id PK
        int seed
        string domain
        string language
        int entry_count
        datetime generated_at
    }
    
    %% Relationships
    MEMORY_SYSTEM ||--o{ EBBINGHAUS_MEMORY : contains
    MEMORY_SYSTEM ||--o{ SEMANTIC_NODE : contains
    MEMORY_SYSTEM ||--o{ SEMANTIC_EDGE : contains
    MEMORY_SYSTEM ||--o{ RAG_DOCUMENT : contains
    
    SEMANTIC_NODE ||--o{ SEMANTIC_EDGE : source
    SEMANTIC_NODE ||--o{ SEMANTIC_EDGE : target
    
    RAG_DOCUMENT ||--o{ RAG_CHUNK : has
    
    CONTRADICTION_RESULT }|--|| EBBINGHAUS_MEMORY : references
    CONTRADICTION_RESULT }|--|| SEMANTIC_NODE : references
    CONTRADICTION_RESULT }|--|| RAG_CHUNK : references
    
    SYNTHETIC_DATASET ||--o{ RAG_DOCUMENT : generates
    SYNTHETIC_DATASET ||--o{ EBBINGHAUS_MEMORY : generates
    SYNTHETIC_DATASET ||--o{ SEMANTIC_NODE : generates
